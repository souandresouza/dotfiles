[
  {
    "name": "topbar",
    "layer": "top",
    "position": "top",
    "height": 20,
    "mode": "dock",
    "exclusive": true,
    "spacing": 0,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "modules-left": [
      "mango/workspaces",
      "custom/sep",
      "custom/mpris"
      //"mpris"
      //"custom/sep"
    ],
    "modules-center": [
      "custom/sep",
      "clock",
      "tray",
      "custom/sep",
      "idle_inhibitor",
      "custom/sep"
    ],
    "modules-right": [
      "custom/sep",
      "bluetooth",
      "custom/sep",
      "network",
      "custom/sep",
      "battery",
      "custom/sep"
    ],
    "clock": {
      "format": "{:L%A, %d/%m/%Y - %T}",
      "timezone": "America/Sao_Paulo",
      "locale": "pt_BR.UTF-8",
      "interval": 1,
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
      "months": "<span color='#ffead3'><b>{}</b></span>",
      "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
      },
      "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
      }
    },
    "custom/sep": {
      "format": "|",
      "interval": 0
      },
    "tray": {
      "icon-size": 14,
      "spacing": 10,
    },
    "custom/mpris": {
      "exec": "python3 -u ~/.config/scripts/scrolling-mpris.py",
      "format": "{text}",
      "return-type": "json",
      "on-click": "playerctl play-pause",
      "on-scroll-down": "playerctl previous",
      "on-click-right": "playerctl next"

	  },
    "idle_inhibitor": {
      "format": "{status}",
      "format-icons": {
        "activated": "✅",
        "desactivated": "❗"
      },
    },
    "bluetooth": {
      "format": " {status}",
      "format-connected": " {device_alias}",
      "format-connected-battery": " {device_alias} {device_battery_percentage}%",
      // "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
      "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
      "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
      "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
      "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    },
    "mango/workspaces": {
      "format": "{}",
      "ignore-hidden": true,
      "on-click": "activate",
      "on-click-right": "toggle",
      "sort-by-id": false,
      },
    "mango/window": {
      "format": "{}",
      "icon-size": 20
      },
    "network": {
      //"interface": "wlp2s0",
      "format": "{ifname} [󰾆 {bandwidthTotalBytes}]",
      "format-wifi": "{icon} {essid} [󰾆 {bandwidthTotalBytes}]",
      "format-ethernet": "󱘖  {ifname} [󰾆 {bandwidthTotalBytes}]",
      "format-disconnected": "󰌙 Disconnected ⚠",
      "format-alt": "  {ipaddr}  {bandwidthUpBytes}  {bandwidthDownBytes}",
      "tooltip-format": "{ifname} via {gwaddr} ",
      "tooltip-format-wifi": "{frequency} MHz ({signalStrength}%)",
      "tooltip-format-ethernet": "{ipaddr}/{cidr}  {bandwidthUpBytes}  {bandwidthDownBytes}",
      "tooltip-format-disconnected": "Disconnected ⚠",
      "max-length": 50,
      "format-icons": [
        "󰤯 ",
        "󰤟 ",
        "󰤢 ",
        "󰤢 ",
        "󰤨 "
      ],
    },
    "battery": {
      //"bat": "BAT2",
      "interval": 60,
      "states": {
        "good": 95,
        "warning": 30,
        "critical": 20,
      },
      "format": "{icon} {capacity}%",
      "format-warning": "{icon} {capacity}%",
      "format-critical": "{icon} {capacity}%",
      "format-charging": " {capacity}%",
      "tooltip": "{time} {icon}",
      "format-alt": "{timeTo} / {health}",
      "format-full": "⚡ {capacity}%",
      "format-icons": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
    },
    "mpris": {
      "format": "{player_icon} {dynamic}",
      "format-paused": "{status_icon} <i>{dynamic}</i>",
      "max-length": 30,
      "player-icons": {
        "default": "󰎆 ",
        "cmus": "",
        "mpv": "🎵",
        "vlc": "🎬",
        "spotify": " ",
      },
      "status-icons": {
        "paused": "⏸",
      },
      "on-click": "playerctl play-pause",
      "on-click-right": "playerctl next",
      "smooth-scrolling-threshold": 10,
      "on-scroll-down": "playerctl previous",
      // "ignored-players": ["cmus", "spotify"]
    },
    // Custom
  },
  {
    "name": "bottombar",
    "layer": "top",
    "position": "bottom",
    "mode": "dock",
    "height": 20,
    "exclusive": true,
    "spacing": 0,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "modules-left": [
      //"custom/weather",
      //"custom/sep",
      //"custom/year",
      "custom/sep",
      "wlr/taskbar",
      "custom/sep",
      "custom/weather",
      "custom/sep"
    ],
    "modules-center": [
      "custom/sep",
      "backlight",
      "custom/sep",
      "wireplumber",
      "custom/sep",
    ],
    "modules-right": [
      "custom/sep",
      "cpu",
      "custom/sep",
      "memory",
      "custom/sep",
      "temperature",
      "custom/sep"
    ],
    "wlr/taskbar": {
      // "format": "{icon}",
      "format": "{icon} {title:.16}",
      "icon-size": 14,
      "icon-theme": "BeautyLine",
      "tooltip-format": "{title}",
      "on-click": "activate",
      "on-click-middle": "close",
    },
    "custom/year": {
      "format": "{}",
      "exec": "~/.config/scripts/year-progress.sh",
      "interval": 3600
    },
    "custom/weather": {
      "format": "{}",
      "interval": 1800,
      "exec": "~/.config/scripts/weather.sh"
      },
    "custom/sep": {
      "format": "|",
      "interval": 0
      },
    "cpu": {
      "interval": 1,
      "format": "󰍛 {usage}%",
      "on-click": "",
      "tooltip": "{avg_frequency}",
    },
    "wireplumber": {
      "format": "{icon} {volume}%",
      "format-muted": " Muted",
      // "format-muted": " {format_source}",
      // "format-source": "{source_volume}% ",
      // "format-source-muted": " ",
      "format-icons": [
        " ",
        " ",
        " "
      ],
      "scroll-step": 0.2,
      "max-volume": 100,
      "on-click": "pavucontrol",
      "on-click-right": "qpwgraph",
    },
    "backlight": {
      "device": "intel_backlight",
      "format": "{icon} {percent}%",
      "format-icons": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      ],
      "on-scroll-up": "brightnessctl set 1%+",
      "on-scroll-down": "brightnessctl set 1%-",
    },
    "temperature": {
      // "thermal-zone": 2,
      // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
      "critical-threshold": 80,
      // "format-critical": "{temperatureC}°C {icon}",
      "format": "{icon} {temperatureC}°C",
      "format-alt": "{temperatureF}°F {icon}",
      "format-icons": [
        "",
        "",
        ""
      ],
      "tooltip": false,
    },
    "memory": {
      "interval": 30,
      "format": " {}%",
      "format-alt": " {used}G",
      "tooltip": true,
      "tooltip-format": "{used:0.1f}G/{total:0.1f}G",
    },
  },
]
