[
  {
    "name": "topbar",
    "layer": "top",
    "position": "top",
    "height": 20,
    "mode": "dock",
    "exclusive": true,
    "spacing": 0,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "modules-left": [
      "ext/workspaces",
      "custom/mpris"
      //"mpris"
    ],
    "modules-center": [
      "clock",
      "tray",
      "idle_inhibitor"
    ],
    "modules-right": [
      "network",
      "battery"
    ],
    "clock": {
      "format": "{:L%A, %d/%m/%Y - %T}",
      "timezone": "America/Sao_Paulo",
      "locale": "pt_BR.UTF-8",
      "interval": 1,
      "tooltip-format": "<tt><small>{calendar}</small></tt>",
      "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
      "months": "<span color='#ffead3'><b>{}</b></span>",
      "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
      },
      "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
      }
    },
    "tray": {
      "icon-size": 14,
      "spacing": 10,
    },
    "custom/mpris": {
      "exec": "python3 -u ~/.config/scripts/scrolling-mpris.py",
      "format": "{text}",
      "return-type": "json",
      "on-click": "playerctl play-pause",
      "on-scroll-down": "playerctl previous",
      "on-click-right": "playerctl next"

	  },
    "idle_inhibitor": {
      "format": "{status}",
      "format-icons": {
        "activated": "✅",
        "desactivated": "❗"
      },
    },
    "ext/workspaces": {
      "format": "{name}",
      "ignore-hidden": true,
      "on-click": "activate",
      "on-click-right": "deactivate",
      "sort-by-id": true,
      },
    "mango/window": {
      "format": "{}",
      "icon-size": 20
      },
    "network": {
      //"interface": "wlp2s0",
      "format": "{ifname} [󰾆 {bandwidthTotalBytes}]",
      "format-wifi": "{icon} {essid} [󰾆 {bandwidthTotalBytes}]",
      "format-ethernet": "󱘖  {ifname} [󰾆 {bandwidthTotalBytes}]",
      "format-disconnected": "󰌙 Disconnected ⚠",
      "format-alt": "  {ipaddr}  {bandwidthUpBytes}  {bandwidthDownBytes}",
      "tooltip-format": "{ifname} via {gwaddr} ",
      "tooltip-format-wifi": "{frequency} MHz ({signalStrength}%)",
      "tooltip-format-ethernet": "{ipaddr}/{cidr}  {bandwidthUpBytes}  {bandwidthDownBytes}",
      "tooltip-format-disconnected": "Disconnected ⚠",
      "max-length": 50,
      "format-icons": [
        "󰤯 ",
        "󰤟 ",
        "󰤢 ",
        "󰤢 ",
        "󰤨 "
      ],
    },
    "battery": {
      "format": "{icon} {capacity}%",
      "format-discharging": "{icon} {capacity}%",
      "format-charging": "{icon} {capacity}%",
      "format-plugged": "",
      "format-icons": {
      "charging": [
      "󰢜 <span size='8pt' color='#df6124'>━</span>",
      "󰢜 <span size='8pt' color='#df6124'>■</span>",
      "󰂆 <span size='8pt' color='#dd7006'>■■</span>",
      "󰂇 <span size='8pt' color='#d88000'>■■■</span>",
      "󰂈 <span size='8pt' color='#d09000'>■■■■</span>",
      "󰢝 <span size='8pt' color='#c5a000'>■■■■■</span>",
      "󰂉 <span size='8pt' color='#b5af00'>■■■■■■</span>",
      "󰢞 <span size='8pt' color='#a2be00'>■■■■■■■</span>",
      "󰂊 <span size='8pt' color='#8acc00'>■■■■■■■■</span>",
      "󰂋 <span size='8pt' color='#68da00'>■■■■■■■■■</span>",
      "󰂅 <span size='8pt' color='#25e712'>■■■■■■■■■■</span>"
      ],
      "default": [
      "󰁺 <span size='8pt' color='#df6124'>━</span>",
      "󰁺 <span size='8pt' color='#df6124'>■</span>",
      "󰁻 <span size='8pt' color='#dd7006'>■■</span>",
      "󰁼 <span size='8pt' color='#d88000'>■■■</span>",
      "󰁽 <span size='8pt' color='#d09000'>■■■■</span>",
      "󰁾 <span size='8pt' color='#c5a000'>■■■■■</span>",
      "󰁿 <span size='8pt' color='#b5af00'>■■■■■■</span>",
      "󰂀 <span size='8pt' color='#a2be00'>■■■■■■■</span>",
      "󰂁 <span size='8pt' color='#8acc00'>■■■■■■■■</span>",
      "󰂂 <span size='8pt' color='#68da00'>■■■■■■■■■</span>",
      "󰁹 <span size='8pt' color='#25e712'>■■■■■■■■■■</span>"
      ]
      },
      "format-full": "󰂅",
      "tooltip-format-discharging": "{timeTo}",
      "tooltip-format-charging": "{timeTo}",
      "interval": 5,
      "states": {
      "warning": 20,
      "critical": 10
      }
    },
    "mpris": {
      "format": "{player_icon} {dynamic}",
      "format-paused": "{status_icon} <i>{dynamic}</i>",
      "max-length": 30,
      "player-icons": {
        "default": "󰎆 ",
        "cmus": "",
        "mpv": "🎵",
        "vlc": "🎬",
        "spotify": " ",
      },
      "status-icons": {
        "paused": "⏸",
      },
      "on-click": "playerctl play-pause",
      "on-click-right": "playerctl next",
      "smooth-scrolling-threshold": 10,
      "on-scroll-down": "playerctl previous",
      // "ignored-players": ["cmus", "spotify"]
    },
    // Custom
  },
  {
    "name": "bottombar",
    "layer": "top",
    "position": "bottom",
    "mode": "dock",
    "height": 20,
    "exclusive": true,
    "spacing": 0,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "modules-left": [
      //"custom/weather",
      //"custom/sep",
      //"custom/year",
      "custom/sep",
      "wlr/taskbar",
      "custom/sep",
      "custom/weather",
      "custom/sep"
    ],
    "modules-center": [
      "backlight",
      "wireplumber",
      "bluetooth",
      "mango/layout",
    ],
    "modules-right": [
      "cpu",
      "memory",
      "temperature",
    ],
    "wlr/taskbar": {
      // "format": "{icon}",
      "format": "{icon} {title:.16}",
      "icon-size": 14,
      "icon-theme": "BeautyLine",
      "tooltip-format": "{title}",
      "on-click": "activate",
      "on-click-middle": "close",
    },
    "custom/year": {
      "format": "{}",
      "exec": "~/.config/scripts/year-progress.sh",
      "interval": 3600
    },
    "custom/weather": {
      "format": "{}",
      "interval": 1800,
      "exec": "~/.config/scripts/weather.sh"
      },
    "mango/layout": {
      "format": "{}",
      "format-S": "Scroller",
      "format-T": "Tile",
      "format-G": "Grid",
      "format-M": "Monocle",
      "format-DW": "Dwindle",
      "format-F": "Fair",
      "format-VF": "Vertical Fair",
      "format-CT": "Center Tile",
      "format-RT": "Right Tile",
      "format-VS": "Vertical Scroller",
      "format-VT": "Vertical Tile",
      "format-VG": "Vertical Grid",
      "format-K": "Deck",
      "format-VK": "Vertical Deck",
      },
    "cpu": {
      "interval": 2,
      "format": "<span size='10pt'></span> {icon} {usage}%",
      "format-icons": [
      "<span size='8pt'>━</span>",
      "<span size='8pt'>■</span>",
      "<span size='8pt' color='#ff79d2'>■■</span>",
      "<span size='8pt' color='#ff6fbe'>■■■</span>",
      "<span size='8pt' color='#ff66a9'>■■■■</span>",
      "<span size='8pt' color='#ff5f94'>■■■■■</span>",
      "<span size='8pt' color='#ff5b7e'>■■■■■■</span>",
      "<span size='8pt' color='#fe5968'>■■■■■■■</span>",
      "<span size='8pt' color='#f65a52'>■■■■■■■■</span>",
      "<span size='8pt' color='#ec5d3c'>■■■■■■■■■</span>",
      "<span size='8pt' color='#df6124'>■■■■■■■■■■</span>"
      ]
      },
    "wireplumber": {
      "format": "{icon} {volume}%",
      "format-muted": " Muted",
      // "format-muted": " {format_source}",
      // "format-source": "{source_volume}% ",
      // "format-source-muted": " ",
      "format-icons": [
        " ",
        " ",
        " "
      ],
      "scroll-step": 0.2,
      "max-volume": 100,
      "on-click": "pavucontrol",
      "on-click-right": "qpwgraph",
    },
    "backlight": {
      "device": "intel_backlight",
      "rotate": 0,
      "format": "{icon} {percent}%",
      "tooltip-format": "🌕 {percent}%",
      "format-icons": [
      "󰃜",
      "󰃝",
      "󰃞",
      "󰃟",
      "󰃠"
      ]
     },
    "temperature": {
      // "thermal-zone": 2,
      // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
      "critical-threshold": 80,
      // "format-critical": "{temperatureC}°C {icon}",
      "format": "{icon} {temperatureC}°C",
      "format-alt": "{temperatureF}°F {icon}",
      "format-icons": [
        "",
        "",
        ""
      ],
      "tooltip": false,
    },
    "memory": {
      "interval": 2,
      "format": "<span size='9pt'></span> {icon} {used:0.1f}G",
      "format-icons": [
      "<span size='8pt'>━</span>",
      "<span size='8pt'>■</span>",
      "<span size='8pt' color='#f7b69a'>■■</span>",
      "<span size='8pt' color='#ef9875'>■■■</span>",
      "<span size='8pt' color='#e77b50'>■■■■</span>",
      "<span size='8pt' color='#df6124'>■■■■■</span>",
      "<span size='8pt' color='#d35720'>■■■■■■</span>",
      "<span size='8pt' color='#c64e1c'>■■■■■■■</span>",
      "<span size='8pt' color='#aa4318'>■■■■■■■■</span>",
      "<span size='8pt' color='#8e3813'>■■■■■■■■■</span>",
      "<span size='8pt' color='#722d0f'>■■■■■■■■■■</span>"
      ]
    },
    "bluetooth": {
      "format": " {status} {num_connections}",
      "format-off": "󰂲 OFF",
      "format-disabled": "󰂲 {status}",
      "format-connected": "󰂱 {num_connections}",
      "tooltip-format": "Devices connected: {num_connections}",
      "on-click": "omarchy-launch-bluetooth"
    },
  },
]
